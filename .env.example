# Frontend only: add these three keys to Vercel PRODUCTION, never preview.
HOMEGRID_APP_ORIGIN=https://homegrid.example.com
GATEWAY_URL=https://homegrid-gateway.example.com
GATEWAY_SERVICE_TOKEN=

# Gateway only: private gateway.env on the Mac/Pi; never upload NVR keys to Vercel.
BETTER_AUTH_SECRET=
MEDIAMTX_SECRET=
GATEWAY_LAN_IP=192.168.1.10
NVR_HOST=192.168.1.100
NVR_PORT=554
NVR_USERNAME=
NVR_PASSWORD=
# Private setup uses NVR_USERNAME_BASE64 / NVR_PASSWORD_BASE64 instead, so
# credentials containing quotes or backslashes survive dotenv parsing exactly.
MEDIAMTX_BINARY=.tools/mediamtx
# Optional: private camera names and NVR channel mapping (six defaults otherwise).
# CAMERAS_JSON=[{"id":"cam-1","name":"Front door","channel":1}]
